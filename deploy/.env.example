# Скопируйте в deploy/.env (он в .gitignore) и задайте свои значения.
# Те же логины и пароли нужны сервисам: dotnet user-secrets или переменные окружения, см. README.
POSTGRES_USER=flux
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flux_transcoder_db
RABBITMQ_USER=flux
RABBITMQ_PASSWORD=change-me
# Адрес, на котором nginx отдаёт HLS. По умолчанию 127.0.0.1 (только эта машина).
# HLS_BIND=0.0.0.0
